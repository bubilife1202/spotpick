# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/builder_curation
REDIS_URL=redis://localhost:6379/0

# Public Data API Keys (https://www.data.go.kr)
DATA_GO_KR_API_KEY=your_api_key_here

# Naver API (https://developers.naver.com)
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# Kakao API (https://developers.kakao.com)
KAKAO_REST_API_KEY=your_api_key

# Gemini (Google AI)
GEMINI_API_KEY=your_api_key

# App Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Scraping Settings
SCRAPE_DELAY_MIN=1.0
SCRAPE_DELAY_MAX=3.0
MAX_CONCURRENT_REQUESTS=5
