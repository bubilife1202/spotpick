  "RECOMMENDATION_TEXT": {
    "time_based": {
      "11-14": "점심 피크 → 런치 세트(버거+감튀+음료) 빠른 회전이 핵심, 대기 3분 이내 목표로 동선 최적화",
      "17-21": "저녁 피크 → 프리미엄 버거/사이드 업셀링으로 객단가 상승, 가족/그룹 세트 강화",
      "21-24": "야식 피크 → 배달앱 상위 노출(리뷰/사진)과 야식 전용 세트(더블버거+너겟)를 강화하세요"
    },
    "day_based": {
      "weekday": "주중 집중 → 직장인 점심 세트 공략(빠른 제공/포장), 주문 피크 12시 전후 인력 집중 배치",
      "weekend": "주말 강세 → 가족 세트/키즈 메뉴 구성과 홀 좌석 회전을 동시에 잡으세요"
    },
    "age_based": {
      "20s": "20대 주요 고객 → 배달앱 마케팅, SNS 프로모션(한정메뉴/쿠폰) 중심으로",
      "30s": "30대 주요 고객 → 프리미엄 수제버거 포지셔닝, 품질+양의 균형을 명확히",
      "40s_plus": "40대+ 주요 고객 → 건강 옵션(샐러드/그릴드), 원산지 표기를 강조해 신뢰를 만드세요"
    },
    "competition": {
      "high": "경쟁 과다 → 시그니처 버거, 자체 소스 차별화로 리뷰 사유를 만드세요",
      "franchise_dense": "프랜차이즈 밀집 → 수제/프리미엄 포지셔닝 또는 극가성비 전략으로 틈새를 공략하세요"
    },
    "area": {
      "골목상권": "골목상권 → 배달+테이크아웃 중심, 단골 리뷰 확보와 세트 구성으로 객단가 관리",
      "발달상권": "발달상권 → 홀 매출+테이크아웃 병행, 점심 피크 회전율과 동선 최적화가 핵심",
      "전통시장": "전통시장 → 가성비 세트 메뉴 전면 배치, 가격/양 메시지를 간판에 명확히",
      "관광특구": "관광특구 → 외국인 대응(영문메뉴/키오스크), 프리미엄 한정메뉴로 객단가 올리세요"
