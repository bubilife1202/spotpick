  "POSITIONING_TYPES": {
    "프리미엄/감성": {
      "weights": {
        "purchasing_power": 40,
        "avg_ticket": 35,
        "ratio_30_40": 25
      },
      "normalization": {
        "purchasing_power": "(1.0 if purchasing_power > 60 else purchasing_power / 60)",
        "avg_ticket": "(1.0 if avg_ticket > 6000 else avg_ticket / 6000)",
        "ratio_30_40": "ratio_30_40"
      }
    },
    "직장인 효율": {
      "weights": {
        "worker_total": 45,
        "peak_time_match": 30,
        "ratio_30_40": 25
      },
      "normalization": {
        "worker_total": "min(1.0, worker_total / 8000)",
        "peak_time_match": "(1.0 if peak_time in (\"11-14\", \"06-11\") else 0.3)",
        "ratio_30_40": "ratio_30_40"
      }
    },
    "테이크아웃/저가": {
      "weights": {
        "foot_traffic_total": 40,
        "purchasing_power_low": 35,
        "facility_subway": 25
      },
      "normalization": {
        "foot_traffic_total": "min(1.0, ft_total / 800000)",
        "purchasing_power_low": "(1.0 if purchasing_power < 40 else max(0, (70 - purchasing_power) / 30))",
        "facility_subway": "(1.0 if facility_subway >= 1 else 0.3)"
      }
    },
    "동네 커뮤니티": {
      "weights": {
        "resident_total": 35,
        "total_households": 30,
        "ratio_30_40": 20,
        "district_type_golmok": 15
      },
      "normalization": {
        "resident_total": "min(1.0, resident_total / 1500)",
        "total_households": "min(1.0, total_households / 800)",
        "ratio_30_40": "ratio_30_40",
        "district_type_golmok": "(0.3 if district_type == \"골목상권\" else 0.0)"
      }
    },
    "학생/스터디": {
      "weights": {
        "ratio_20": 40,
        "facility_university": 35,
        "purchasing_power_low": 25
      },
      "normalization": {
        "ratio_20": "ratio_20",
        "facility_university": "min(1.0, facility_university)",
        "purchasing_power_low": "(1.0 if purchasing_power < 50 else max(0, (70 - purchasing_power) / 20))"
      }
    }
  },
